{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/s/:code", "destination": "/api/share?kind=s&code=:code" },
    { "source": "/m/:code", "destination": "/api/share?kind=m&code=:code" }
  ],
  "redirects": [
    { "source": "/", "destination": "https://welileapp.com", "permanent": false }
  ]
}
