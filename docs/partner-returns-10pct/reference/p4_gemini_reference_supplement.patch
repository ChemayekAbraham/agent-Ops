@@ -0,0 +1,46 @@
+import { cn } from '@/lib/utils';
+import { formatRatePct, rateNeedsCfoApproval, type PartnerReturnPolicy } from '@/lib/partnerReturnPolicy';
+
+interface PartnerRateCfoNoteProps {
+  policy: PartnerReturnPolicy;
+  /** The rate staff typed (raw input value or number). */
+  typedRate: string | number | null | undefined;
+  /**
+   * The portfolio's stored rate when this form CHANGES an existing portfolio (edit, renewal).
+   * Omit for a new portfolio, which earns the standard rate while the CFO decides.
+   */
+  currentRate?: number | null;
+  className?: string;
+}
+
+/** Whether the note would show, for callers that need the same answer (tests, button copy). */
+export function partnerRateNeedsCfoNote(
+  policy: PartnerReturnPolicy,
+  typedRate: string | number | null | undefined,
+  currentRate?: number | null,
+): boolean {
+  const typed = typedRate === '' || typedRate == null ? null : Number(typedRate);
+  if (!rateNeedsCfoApproval(policy, typed)) return false;
+  // Leaving an existing portfolio's rate as it is sends nothing to the CFO
+  // (trg_partner_return_rate_policy only reacts to a change).
+  return currentRate == null || typed !== Number(currentRate);
+}
+
+/**
+ * Inline note under a staff "Returns rate" field. While the partner Returns switch is on,
+ * a rate other than the standard one is held by the database for CFO approval:
+ * a new portfolio earns the standard rate meanwhile, an existing one keeps its rate.
+ */
+export function PartnerRateCfoNote({ policy, typedRate, currentRate, className }: PartnerRateCfoNoteProps) {
+  if (!partnerRateNeedsCfoNote(policy, typedRate, currentRate)) return null;
+  const meanwhile = currentRate != null
+    ? `keeps its current ${formatRatePct(Number(currentRate))}`
+    : `earns ${formatRatePct(policy.newContractRate)}`;
+  return (
+    <p role="note" className={cn('text-[11px] leading-snug text-amber-700 dark:text-amber-400', className)}>
+      Needs CFO approval. The portfolio {meanwhile} until the CFO approves; an approved rate applies from the next cycle.
+    </p>
+  );
+}
+
+export default PartnerRateCfoNote;
