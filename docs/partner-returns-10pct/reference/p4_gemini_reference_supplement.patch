@@ -0,0 +1,51 @@
+import { useQuery } from '@tanstack/react-query';
+import { supabase } from '@/integrations/supabase/client';
+import { LEGACY_PARTNER_RETURN_RATE } from '@/lib/partnerReturnPolicy';
+
+/**
+ * The Returns rate and template version a partner's agreement states
+ * (partner_agreement_terms, migration 20261105153000):
+ *   executed (countersigned) agreement → the rate frozen on it;
+ *   unsigned / no agreement            → what an agreement signed now states (live policy).
+ * Contract renderers pass `returnRate` to buildAgreementHtml, and the countersign request
+ * sends it back so the server can refuse if the terms changed while the agreement was open.
+ * Before the migration is applied the call fails and the legacy 15% (v1.0 text) is used.
+ */
+export interface PartnerAgreementTerms {
+  returnRate: number;
+  version: string;
+  executed: boolean;
+  rateSource: 'agreement' | 'policy' | 'fallback';
+}
+
+export const LEGACY_AGREEMENT_TERMS: PartnerAgreementTerms = {
+  returnRate: LEGACY_PARTNER_RETURN_RATE,
+  version: 'v1.0',
+  executed: false,
+  rateSource: 'fallback',
+};
+
+export async function fetchPartnerAgreementTerms(partnerId: string): Promise<PartnerAgreementTerms> {
+  const { data, error } = await (supabase.rpc as unknown as (
+    fn: string, args: Record<string, unknown>,
+  ) => Promise<{ data: Record<string, unknown> | null; error: Error | null }>)(
+    'partner_agreement_terms', { p_partner_id: partnerId },
+  );
+  if (error || !data) return LEGACY_AGREEMENT_TERMS;
+  const rate = Number(data.return_rate);
+  return {
+    returnRate: Number.isFinite(rate) && rate > 0 ? rate : LEGACY_PARTNER_RETURN_RATE,
+    version: typeof data.agreement_version === 'string' && data.agreement_version ? data.agreement_version : 'v1.0',
+    executed: data.executed === true,
+    rateSource: data.rate_source === 'agreement' ? 'agreement' : 'policy',
+  };
+}
+
+export function usePartnerAgreementTerms(partnerId: string | null | undefined) {
+  return useQuery({
+    queryKey: ['partner-agreement-terms', partnerId],
+    enabled: !!partnerId,
+    queryFn: () => fetchPartnerAgreementTerms(partnerId as string),
+    staleTime: 60_000,
+  });
+}
diff --git a/src/hooks/usePartnerReturnPolicy.ts b/src/hooks/usePartnerReturnPolicy.ts
new file mode 100644
index 0000000000..078b6e01e0
--- /dev/null
+++ b/src/hooks/usePartnerReturnPolicy.ts
@@ -0,0 +1,74 @@
+import { useQuery } from '@tanstack/react-query';
+import { supabase } from '@/integrations/supabase/client';
+import {
+  LEGACY_PARTNER_RETURN_POLICY,
+  parsePartnerReturnPolicy,
+  type PartnerReturnPolicy,
+} from '@/lib/partnerReturnPolicy';
+
+/**
+ * The live partner Returns policy (get_partner_return_policy — readable before login,
+ * so public calculators and landing pages show the same rate the database applies).
+ *
+ *   newContractRate  what a NEW contract earns now (10 when the switch is on, 15 while off)
+ *   policyRate       the rate renewals move to when the switch is on
+ *   enabled          whether the switch is on
+ *
+ * One request per session (cached, shared by every component through react-query).
+ * The last value seen is kept in localStorage so a returning visitor never sees the
+ * number change after the page loads; a first visit shows the legacy rate until the
+ * request answers (isFallback tells a screen that would rather wait).
+ */
+export const PARTNER_RETURN_POLICY_QUERY_KEY = ['partner-return-policy'] as const;
+const STORAGE_KEY = 'welile.partnerReturnPolicy.v1';
+
+function readCached(): PartnerReturnPolicy | undefined {
+  try {
+    const raw = localStorage.getItem(STORAGE_KEY);
+    return raw ? parsePartnerReturnPolicy(JSON.parse(raw)) : undefined;
+  } catch {
+    return undefined;
+  }
+}
+
+function writeCached(p: PartnerReturnPolicy) {
+  try {
+    localStorage.setItem(STORAGE_KEY, JSON.stringify({
+      enabled: p.enabled, new_contract_rate: p.newContractRate, policy_rate: p.policyRate,
+      agreement_version: p.agreementVersion,
+    }));
+  } catch {
+    /* private mode / storage blocked: the live value still applies */
+  }
+}
+
+export async function fetchPartnerReturnPolicy(): Promise<PartnerReturnPolicy> {
+  // Not in the generated types yet (added by migration 20261105150000).
+  const { data, error } = await (supabase.rpc as unknown as (fn: string) => Promise<{ data: unknown; error: Error | null }>)(
+    'get_partner_return_policy',
+  );
+  if (error) throw error;
+  const policy = parsePartnerReturnPolicy(data);
+  writeCached(policy);
+  return policy;
+}
+
+export function usePartnerReturnPolicy() {
+  const cached = readCached();
+  const query = useQuery({
+    queryKey: PARTNER_RETURN_POLICY_QUERY_KEY,
+    queryFn: fetchPartnerReturnPolicy,
+    // The switch changes once at go-live; five minutes keeps every screen in step without polling.
+    staleTime: 5 * 60_000,
+    retry: 1,
+    ...(cached ? { initialData: cached, initialDataUpdatedAt: 0 } : {}),
+  });
+
+  const policy = query.data ?? cached ?? LEGACY_PARTNER_RETURN_POLICY;
+  return {
+    ...policy,
+    isLoading: query.isLoading,
+    /** True until the live policy has answered at least once (value shown is a guess). */
+    isFallback: query.isFetched !== true || query.isError,
+  };
+}
diff --git a/src/lib/partnerReturnPolicy.ts b/src/lib/partnerReturnPolicy.ts
new file mode 100644
index 0000000000..5d8456732f
--- /dev/null
+++ b/src/lib/partnerReturnPolicy.ts
@@ -0,0 +1,80 @@
+// Partner Returns rates for the browser.
+//
+// The database owns the rate (partner_return_policy, migration 20261105150000):
+//   * a NEW contract earns newContractRate — 10 when the switch is on, the legacy 15 while off;
+//   * a RENEWAL earns the policy rate when the switch is on, otherwise keeps its rate;
+//   * an EXISTING portfolio always earns its own stored roi_percentage (15 / 20 / ...).
+// Screens read the live policy through usePartnerReturnPolicy(); this module holds the
+// pure helpers so calculators, offers and forms share one rule instead of copying 0.15.
+// Mirrors supabase/functions/_shared/partnerReturnPolicy.ts.
+
+export const LEGACY_PARTNER_RETURN_RATE = 15;
+
+export interface PartnerReturnPolicy {
+  enabled: boolean;
+  /** What a new contract earns right now (policy rate when on, legacy rate when off). */
+  newContractRate: number;
+  /** The rate the switch applies when on (10). */
+  policyRate: number;
+  /** Agreement template version signed now (v1.0 while off, v2.0 when on). */
+  agreementVersion: string;
+}
+
+export const LEGACY_PARTNER_RETURN_POLICY: PartnerReturnPolicy = {
+  enabled: false,
+  newContractRate: LEGACY_PARTNER_RETURN_RATE,
+  policyRate: LEGACY_PARTNER_RETURN_RATE,
+  agreementVersion: 'v1.0',
+};
+
+const positive = (v: unknown, fallback: number) => {
+  const n = Number(v);
+  return Number.isFinite(n) && n > 0 ? n : fallback;
+};
+
+/** Parse the jsonb returned by get_partner_return_policy(); anything unusable → today's behaviour. */
+export function parsePartnerReturnPolicy(raw: unknown): PartnerReturnPolicy {
+  if (!raw || typeof raw !== 'object' || Array.isArray(raw)) return LEGACY_PARTNER_RETURN_POLICY;
+  const r = raw as Record<string, unknown>;
+  const newContractRate = positive(r.new_contract_rate, LEGACY_PARTNER_RETURN_RATE);
+  return {
+    enabled: r.enabled === true,
+    newContractRate,
+    policyRate: positive(r.policy_rate, newContractRate),
+    agreementVersion: typeof r.agreement_version === 'string' && r.agreement_version ? r.agreement_version : 'v1.0',
+  };
+}
+
+/** Mirrors SQL partner_renewal_rate(): the policy rate when the switch is on, otherwise the current rate. */
+export function renewalRateFor(policy: PartnerReturnPolicy, currentRate: number): number {
+  return policy.enabled ? policy.policyRate : currentRate;
+}
+
+/**
+ * Whether a rate staff typed will wait for CFO approval. Only while the switch is on,
+ * and only when it differs from the standard (new-contract) rate.
+ */
+export function rateNeedsCfoApproval(policy: PartnerReturnPolicy, typedRate: number | null | undefined): boolean {
+  if (!policy.enabled || typedRate == null || !Number.isFinite(Number(typedRate))) return false;
+  return Number(typedRate) !== policy.newContractRate;
+}
+
+/** A percentage as a fraction: 10 → 0.1. */
+export function rateFraction(ratePct: number): number {
+  return (Number(ratePct) || 0) / 100;
+}
+
+/** Monthly Returns on an amount at a percentage rate, rounded to the shilling. */
+export function monthlyReturnFor(amount: number, ratePct: number): number {
+  return Math.round((Number(amount) || 0) * rateFraction(ratePct));
+}
+
+/** 10 → "10%", 12.5 → "12.5%". */
+export function formatRatePct(ratePct: number): string {
+  return `${Math.round(Number(ratePct) * 100) / 100}%`;
+}
+
+/** The stored rate on a portfolio-like row, or the fallback when the row lacks it. */
+export function storedRateOf(row: { roi_percentage?: unknown } | null | undefined, fallback: number): number {
+  return positive(row?.roi_percentage, fallback);
+}
diff --git a/src/lib/__tests__/partnerReturnPolicy.test.ts b/src/lib/__tests__/partnerReturnPolicy.test.ts
