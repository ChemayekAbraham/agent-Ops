@@ -0,0 +1,51 @@
+import { describe, expect, it } from 'vitest';
+import {
+  formatRatePct,
+  LEGACY_PARTNER_RETURN_POLICY,
+  monthlyReturnFor,
+  parsePartnerReturnPolicy,
+  rateFraction,
+  rateNeedsCfoApproval,
+  renewalRateFor,
+  storedRateOf,
+} from '../partnerReturnPolicy';
+
+const ON = { enabled: true, newContractRate: 10, policyRate: 10, agreementVersion: 'v1.0' };
+const OFF = { enabled: false, newContractRate: 15, policyRate: 10, agreementVersion: 'v1.0' };
+
+describe('parsePartnerReturnPolicy', () => {
+  it('reads the switch and rates, including Postgres numeric strings', () => {
+    expect(parsePartnerReturnPolicy({ enabled: true, new_contract_rate: '10.00', policy_rate: 10 })).toEqual(ON);
+    expect(parsePartnerReturnPolicy({ enabled: false, new_contract_rate: 15, policy_rate: 10 })).toEqual(OFF);
+    expect(parsePartnerReturnPolicy({ enabled: true, new_contract_rate: 10, policy_rate: 10, agreement_version: 'v2.0' }).agreementVersion).toBe('v2.0');
+  });
+  it('falls back to today’s behaviour on anything unusable', () => {
+    for (const bad of [null, undefined, 'x', [], { enabled: 'yes', new_contract_rate: -1 }]) {
+      const p = parsePartnerReturnPolicy(bad);
+      expect(p.newContractRate).toBe(15);
+      expect(p.enabled).toBe(false);
+    }
+    expect(parsePartnerReturnPolicy(null)).toEqual(LEGACY_PARTNER_RETURN_POLICY);
+  });
+});
+
+describe('rules', () => {
+  it('renewals move to the policy rate only when the switch is on', () => {
+    expect(renewalRateFor(ON, 20)).toBe(10);
+    expect(renewalRateFor(OFF, 20)).toBe(20);
+  });
+  it('a typed rate needs the CFO only when the switch is on and it is not the standard rate', () => {
+    expect(rateNeedsCfoApproval(ON, 15)).toBe(true);
+    expect(rateNeedsCfoApproval(ON, 10)).toBe(false);
+    expect(rateNeedsCfoApproval(OFF, 20)).toBe(false);
+    expect(rateNeedsCfoApproval(ON, null)).toBe(false);
+  });
+  it('amounts and labels', () => {
+    expect(rateFraction(10)).toBe(0.1);
+    expect(monthlyReturnFor(300_000, 10)).toBe(30_000);
+    expect(monthlyReturnFor(300_000, 15)).toBe(45_000);
+    expect(formatRatePct(12.5)).toBe('12.5%');
+    expect(storedRateOf({ roi_percentage: '20' }, 10)).toBe(20);
+    expect(storedRateOf(null, 10)).toBe(10);
+  });
+});
