@@ -0,0 +1,16 @@
+import { limiterClient } from "./rateLimit";
+import { LEGACY_PARTNER_RETURN_RATE, parsePartnerReturnPolicy } from "../partnerReturnPolicy";
+
+// What a NEW Supporter earns per month right now (partner Returns policy, readable before
+// login). One request per tool call; any failure falls back to today's behaviour.
+export async function newPartnerReturnRate(): Promise<number> {
+  try {
+    const client = limiterClient();
+    if (!client) return LEGACY_PARTNER_RETURN_RATE;
+    const { data, error } = await client.rpc("get_partner_return_policy" as never);
+    if (error) return LEGACY_PARTNER_RETURN_RATE;
+    return parsePartnerReturnPolicy(data).newContractRate;
+  } catch {
+    return LEGACY_PARTNER_RETURN_RATE;
+  }
+}
