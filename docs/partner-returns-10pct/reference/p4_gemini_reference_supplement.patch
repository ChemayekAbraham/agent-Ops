@@ -0,0 +1,83 @@
+/**
+ * Partner Returns on NEW contracts follow the live policy (usePartnerReturnPolicy):
+ * 15% while the switch is off, 10% once it is on. Existing portfolios keep their
+ * stored rate. Nothing here may hard-code 15.
+ */
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import { render, screen } from '@testing-library/react';
+
+const mockPolicy = vi.hoisted(() => ({
+  enabled: false, newContractRate: 15, policyRate: 15, isLoading: false, isFallback: false,
+}));
+vi.mock('@/hooks/usePartnerReturnPolicy', () => ({ usePartnerReturnPolicy: () => mockPolicy }));
+vi.mock('@/integrations/supabase/client', () => ({ supabase: { rpc: vi.fn(), from: vi.fn() } }));
+
+import { calcFunderEarnings } from '@/lib/funderEarnings';
+import { calculateSupporterReward } from '@/lib/rentCalculations';
+import { planShareDescription } from '@/lib/planShareLink';
+import { houseMonthlyReturn } from '@/lib/houseSupportShare';
+import { itemMonthlyReturn, toSelectionItem } from '@/components/funder-new/utils';
+import type { FunderNewReadyPlan } from '@/components/funder-new/types';
+import { LEGACY_PARTNER_RETURN_RATE } from '@/lib/partnerReturnPolicy';
+import { SetGoalDialog } from '@/components/supporter/SetGoalDialog';
+import { FunderNewHero } from '@/components/funder-new/FunderNewHero';
+
+const switchOff = () => Object.assign(mockPolicy, { enabled: false, newContractRate: LEGACY_PARTNER_RETURN_RATE, policyRate: LEGACY_PARTNER_RETURN_RATE });
+const switchOn = () => Object.assign(mockPolicy, { enabled: true, newContractRate: 10, policyRate: 10 });
+
+beforeEach(switchOff);
+
+describe('new-contract Returns helpers take the rate, never a literal', () => {
+  it('prices funder house earnings at the rate given', () => {
+    const start = new Date('2026-01-01T00:00:00Z');
+    expect(calcFunderEarnings(200_000, start, LEGACY_PARTNER_RETURN_RATE).monthly).toBe(30_000);
+    expect(calcFunderEarnings(200_000, start, 10).monthly).toBe(20_000);
+    expect(calcFunderEarnings(200_000, start, 10).annual).toBe(240_000);
+  });
+
+  it('prices supporter rewards, share copy and house Returns at the rate given', () => {
+    expect(calculateSupporterReward(300_000, LEGACY_PARTNER_RETURN_RATE)).toBe(45_000);
+    expect(calculateSupporterReward(300_000, 10)).toBe(30_000);
+    expect(houseMonthlyReturn(300_000, 10)).toBe(30_000);
+    const plan = { rent_request_id: 'p1', funding_amount: 300_000 };
+    expect(planShareDescription(plan, 10)).toContain('30,000');
+    expect(planShareDescription(plan, LEGACY_PARTNER_RETURN_RATE)).toContain('45,000');
+  });
+
+  it('prices a ready plan selection at the rate given', () => {
+    const plan = { rent_request_id: 'p2', funding_amount: 500_000 } as unknown as FunderNewReadyPlan;
+    expect(itemMonthlyReturn('ready', plan, LEGACY_PARTNER_RETURN_RATE)).toBe(75_000);
+    expect(itemMonthlyReturn('ready', plan, 10)).toBe(50_000);
+    expect(toSelectionItem('ready', plan, 10).monthlyReturn).toBe(50_000);
+  });
+});
+
+describe('screens switch from 15% to 10% with the policy', () => {
+  const goal = { id: 'g1', name: 'School fees', targetAmount: 150_000, currentAmount: 0, deadline: '2027-01-01T00:00:00Z', createdAt: '2026-01-01T00:00:00Z', color: 'blue' };
+
+  it('goal calculator sizes the support at the live rate', () => {
+    const { unmount } = render(<SetGoalDialog open onOpenChange={vi.fn()} goal={goal} onSave={vi.fn()} />);
+    expect(screen.getByText('at 15% monthly Returns')).toBeTruthy();
+    expect(screen.getByText(/1,000,000/)).toBeTruthy();
+    unmount();
+
+    switchOn();
+    render(<SetGoalDialog open onOpenChange={vi.fn()} goal={goal} onSave={vi.fn()} />);
+    expect(screen.getByText('at 10% monthly Returns')).toBeTruthy();
+    expect(screen.getByText(/1,500,000/)).toBeTruthy();
+    expect(screen.queryByText('at 15% monthly Returns')).toBeNull();
+  });
+
+  it('funder hero headline quotes the live rate', () => {
+    const summary = { houseCount: 3, totalRentNeeded: 900_000, avgMonthlyRent: 300_000, districts: [] };
+    const props = { summary, isLoading: false, hasError: false, onHowItWorks: vi.fn() };
+    const { unmount } = render(<FunderNewHero {...props} />);
+    expect(screen.getByText('15%')).toBeTruthy();
+    unmount();
+
+    switchOn();
+    render(<FunderNewHero {...props} />);
+    expect(screen.getByText('10%')).toBeTruthy();
+    expect(screen.queryByText('15%')).toBeNull();
+  });
+});
diff --git a/src/components/partner/__tests__/InvitePartnerPortfolioDialog.rate.test.tsx b/src/components/partner/__tests__/InvitePartnerPortfolioDialog.rate.test.tsx
new file mode 100644
index 0000000000..a3bc08cc20
--- /dev/null
+++ b/src/components/partner/__tests__/InvitePartnerPortfolioDialog.rate.test.tsx
@@ -0,0 +1,63 @@
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import type { ReactNode } from 'react';
+import { cleanup, fireEvent, render, screen } from '@testing-library/react';
+import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
+
+// A staff new-portfolio form: starts at the policy's new-contract rate and explains the CFO gate.
+const mocks = vi.hoisted(() => ({
+  policy: { enabled: true, newContractRate: 10, policyRate: 10 },
+}));
+
+vi.mock('@/integrations/supabase/client', () => ({
+  supabase: { functions: { invoke: vi.fn() }, rpc: vi.fn() },
+}));
+vi.mock('@/hooks/use-toast', () => ({ useToast: () => ({ toast: vi.fn() }) }));
+vi.mock('@/hooks/usePartnerReturnPolicy', () => ({
+  usePartnerReturnPolicy: () => ({ ...mocks.policy, isLoading: false, isFallback: false }),
+  PARTNER_RETURN_POLICY_QUERY_KEY: ['partner-return-policy'],
+}));
+
+import { InvitePartnerPortfolioDialog } from '../InvitePartnerPortfolioDialog';
+
+const qc = new QueryClient();
+const wrapper = ({ children }: { children: ReactNode }) => <QueryClientProvider client={qc}>{children}</QueryClientProvider>;
+const dialog = () => <InvitePartnerPortfolioDialog open onOpenChange={() => {}} partner={{ id: 'p1', full_name: 'Alice' }} />;
+const rateInput = () => screen.getByLabelText('Monthly ROI (%)') as HTMLInputElement;
+const note = () => screen.queryByText(/Needs CFO approval/);
+
+beforeEach(() => {
+  cleanup();
+  mocks.policy = { enabled: true, newContractRate: 10, policyRate: 10 };
+});
+
+describe('staff rate field and the CFO note', () => {
+  it('starts at the policy rate with no note, and shows the note for any other rate while the switch is on', () => {
+    render(dialog(), { wrapper });
+    expect(rateInput().value).toBe('10');
+    expect(note()).toBeNull();
+    fireEvent.change(rateInput(), { target: { value: '15' } });
+    expect(note()).toHaveTextContent('The portfolio earns 10% until the CFO approves; an approved rate applies from the next cycle.');
+  });
+
+  it('shows no note while the switch is off, whatever rate is typed', () => {
+    mocks.policy = { enabled: false, newContractRate: 15, policyRate: 10 };
+    render(dialog(), { wrapper });
+    expect(rateInput().value).toBe('15');
+    fireEvent.change(rateInput(), { target: { value: '20' } });
+    expect(note()).toBeNull();
+  });
+
+  it('moves an untouched field when the live policy answers, but never a typed rate', () => {
+    mocks.policy = { enabled: false, newContractRate: 15, policyRate: 10 };
+    const view = render(dialog(), { wrapper });
+    expect(rateInput().value).toBe('15');
+    mocks.policy = { enabled: true, newContractRate: 10, policyRate: 10 };
+    view.rerender(dialog());
+    expect(rateInput().value).toBe('10');
+
+    fireEvent.change(rateInput(), { target: { value: '12' } });
+    mocks.policy = { enabled: true, newContractRate: 11, policyRate: 11 };
+    view.rerender(dialog());
+    expect(rateInput().value).toBe('12');
+  });
+});
