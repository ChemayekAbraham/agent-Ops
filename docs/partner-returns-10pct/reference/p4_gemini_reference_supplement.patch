+
+// Fixtures were rendered from the template BEFORE the Phase 4 change (fixed "fifteen per cent").
+const fixture = (name: string) => readFileSync(join(__dirname, '__fixtures__', `agreement_v1_${name}.html`), 'utf8');
+const base = (returnOption?: 'A' | 'B'): AgreementFillData => ({
+  partnerName: 'Test Partner', partnerId: 'CM123', partnerAddress: 'Kampala', partnerPhone: '0700000000',
+  partnerEmail: 't@example.com', partnershipAmount: 2_500_000, returnOption,
+  reference: 'WLP-2026-TEST', agreementDate: new Date('2026-11-05T09:00:00Z'), payoutMode: 'momo',
+  momoProvider: 'MTN', momoNumber: '0700000000', momoName: 'Test', kinName: 'Kin', kinContact: '0711',
+  supportMode: 'company_managed',
