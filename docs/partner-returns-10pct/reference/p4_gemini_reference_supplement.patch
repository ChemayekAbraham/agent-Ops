+
+describe('partner agreement states its own Returns rate (Phase 4)', () => {
+  it.each([['A', 'A'], ['B', 'B'], ['none', undefined]] as const)(
+    'v1.0 text is unchanged, byte for byte, with no rate or with 15%% (option %s)',
+    (name, opt) => {
+      expect(buildAgreementHtml(base(opt))).toBe(fixture(name));
+      expect(buildAgreementHtml({ ...base(opt), returnRate: 15 })).toBe(fixture(name));
+    },
+  );
+
+  it('a 10% agreement states 10% in clause 4.1, both option lines and the illustration', () => {
