@@ -0,0 +1,24 @@
+import { useEffect, useRef } from 'react';
+
+/**
+ * Keeps a staff "Returns rate" input on a rate derived from the partner Returns policy
+ * (policy.newContractRate for a new portfolio, renewalRateFor(...) for a renewal).
+ *
+ * Forms start the field at that default. If the live policy answers (or the switch flips)
+ * after the form opened, a field still showing the previous default moves to the new one;
+ * a rate staff typed themselves is left alone.
+ */
+export function useFollowPolicyRate(
+  defaultRate: number,
+  value: string,
+  setValue: (next: string) => void,
+) {
+  const shown = useRef(defaultRate);
+  useEffect(() => {
+    const previous = shown.current;
+    shown.current = defaultRate;
+    if (previous !== defaultRate && value === String(previous)) setValue(String(defaultRate));
+    // Only a change of the default moves the field; typing must never be overridden.
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [defaultRate]);
+}
