# Welile — Local development environment template
# Copy this file to .env and replace placeholder values with your own local setup.
# DO NOT commit real secrets or production credentials.

# ---------------------------------------------------------------------------
# Lovable Cloud / Supabase public values (safe in browser bundle)
# These are NOT secrets — RLS protects your data. Use your local project values.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# ---------------------------------------------------------------------------
# Local PostgreSQL connection (for psql / local tooling only — never the browser)
# Example: postgresql://postgres:postgres@localhost:54322/postgres
# ---------------------------------------------------------------------------
PGHOST=localhost
PGPORT=54322
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=postgres

# ---------------------------------------------------------------------------
# Optional: local Edge Function / backend development
# ---------------------------------------------------------------------------
SUPABASE_ACCESS_TOKEN=your-personal-access-token
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

# ---------------------------------------------------------------------------
# Optional integrations (replace with your own sandbox/test keys)
# ---------------------------------------------------------------------------
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_BROWSER_KEY=your-maps-browser-key
