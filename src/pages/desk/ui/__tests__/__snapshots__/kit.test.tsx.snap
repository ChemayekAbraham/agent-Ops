// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`command-centre look > Card is the command-centre panel; the brief variant tightens to 8px 1`] = `"<div><section class="desk-panel min-w-0" style="display: flex; flex-direction: column; gap: var(--desk-card-gap, 14px); min-width: 0; padding: var(--desk-card-pad, 20px);"><div style="display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px;"><h2 class="text-base font-semibold text-foreground" style="margin: 0px;">Today’s blockers</h2></div><p>body</p></section><section class="desk-panel min-w-0" style="display: flex; flex-direction: column; gap: var(--desk-space-2, 8px); min-width: 0; padding: var(--desk-card-pad, 20px);"><div style="display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px;"><h2 class="text-base font-semibold text-foreground" style="margin: 0px;">Today on Welile</h2></div><ol style="display: flex; flex-direction: column; gap: 6px; min-width: 0; margin: 0px; padding: 0px; list-style: none;"><li class="text-sm leading-snug text-foreground">One.</li><li class="text-sm leading-snug text-foreground">Two.</li></ol><p class="desk-label" style="margin: 0px;">As at 09:30 Kampala</p></section></div>"`;

exports[`kit snapshots > Chip and CountChip, every tone 1`] = `"<div><span data-tone="idle" class="desk-pill text-[11px]  bg-[var(--desk-surface)] border-[var(--desk-line-color)] text-muted-foreground " style="display: inline-flex; align-items: center; gap: 4px; white-space: nowrap; padding: 2px 8px 2px 8px; border-width: 1px; border-style: solid; border-radius: 999px;">idle</span><span data-tone="ok" class="desk-pill text-[11px]  bg-[hsl(var(--desk-ok-dot)/0.15)] border-[hsl(var(--desk-ok-dot)/0.6)] text-[hsl(var(--desk-ok))] " style="display: inline-flex; align-items: center; gap: 4px; white-space: nowrap; padding: 2px 8px 2px 8px; border-width: 1px; border-style: solid; border-radius: 999px;">ok</span><span data-tone="warn" class="desk-pill text-xs  bg-[hsl(var(--desk-warn-dot)/0.15)] border-[hsl(var(--desk-warn-dot)/0.6)] text-[hsl(var(--desk-warn))] " style="display: inline-flex; align-items: center; gap: 4px; white-space: nowrap; padding: 2px 10px 2px 10px; border-width: 1px; border-style: solid; border-radius: 999px;">warn</span><span data-tone="bad" class="desk-pill text-[11px] font-semibold bg-[hsl(var(--desk-bad-dot)/0.15)] border-[hsl(var(--desk-bad-dot)/0.6)] text-[hsl(var(--desk-bad))] " style="display: inline-flex; align-items: center; gap: 4px; white-space: nowrap; padding: 2px 8px 2px 8px; border-width: 1px; border-style: solid; border-radius: 999px;">Time up</span><span data-tone="idle" class="desk-pill text-xs  bg-[var(--desk-surface)] border-[var(--desk-line-color)] text-muted-foreground tabular-nums" style="display: inline-flex; align-items: center; gap: 4px; white-space: nowrap; padding: 2px 10px 2px 10px; border-width: 1px; border-style: solid; border-radius: 999px;">12</span><span data-tone="idle" class="desk-pill text-xs  bg-[var(--desk-surface)] border-[var(--desk-line-color)] text-muted-foreground tabular-nums" style="display: inline-flex; align-items: center; gap: 4px; white-space: nowrap; padding: 2px 10px 2px 10px; border-width: 1px; border-style: solid; border-radius: 999px;">—</span></div>"`;

exports[`kit snapshots > DecisionButton, every variant and size 1`] = `"<div><button type="button" data-variant="primary" class="desk-pill font-medium transition-colors motion-reduce:transition-none focus:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-[hsl(var(--background))] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[hsl(var(--ring))] disabled:cursor-not-allowed disabled:opacity-50 text-xs border-[hsl(var(--desk-primary-solid))] bg-[hsl(var(--desk-primary-solid))] text-[hsl(var(--desk-primary-solid-fg))] font-semibold shadow-sm hover:border-[hsl(var(--desk-primary-solid-hover))] hover:bg-[hsl(var(--desk-primary-solid-hover))]  " style="display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; padding: 4px 12px 4px 12px; border-width: 1px; border-style: solid; border-radius: 999px; justify-content: center;">Pass</button><button type="button" data-variant="quiet" class="desk-pill font-medium transition-colors motion-reduce:transition-none focus:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-[hsl(var(--background))] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[hsl(var(--ring))] disabled:cursor-not-allowed disabled:opacity-50 text-xs border-[var(--desk-line-color)] bg-[var(--desk-surface)] text-muted-foreground hover:bg-[var(--desk-surface-hover)] hover:text-foreground  " style="display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; padding: 4px 12px 4px 12px; border-width: 1px; border-style: solid; border-radius: 999px; justify-content: center;">Open the review</button><button type="button" data-variant="danger" class="desk-pill font-medium transition-colors motion-reduce:transition-none focus:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-[hsl(var(--background))] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[hsl(var(--ring))] disabled:cursor-not-allowed disabled:opacity-50 text-xs bg-[hsl(var(--desk-bad-dot)/0.15)] border-[hsl(var(--desk-bad-dot)/0.6)] text-[hsl(var(--desk-bad))]  " style="display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; padding: 4px 12px 4px 12px; border-width: 1px; border-style: solid; border-radius: 999px; justify-content: center;">Reject</button><button type="button" data-variant="warn" class="desk-pill font-medium transition-colors motion-reduce:transition-none focus:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-[hsl(var(--background))] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[hsl(var(--ring))] disabled:cursor-not-allowed disabled:opacity-50 text-xs bg-[hsl(var(--desk-warn-dot)/0.15)] border-[hsl(var(--desk-warn-dot)/0.6)] text-[hsl(var(--desk-warn))]  " style="display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; padding: 4px 12px 4px 12px; border-width: 1px; border-style: solid; border-radius: 999px; justify-content: center;">Retry the move only</button><button type="button" data-variant="ok" class="desk-pill font-medium transition-colors motion-reduce:transition-none focus:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-[hsl(var(--background))] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[hsl(var(--ring))] disabled:cursor-not-allowed disabled:opacity-50 text-sm bg-[hsl(var(--desk-ok-dot)/0.15)] border-[hsl(var(--desk-ok-dot)/0.6)] text-[hsl(var(--desk-ok))]  " style="display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; padding: 8px 16px 8px 16px; border-width: 1px; border-style: solid; border-radius: 999px; justify-content: center;">Push all 3</button><button type="button" data-variant="quiet" class="desk-pill font-medium transition-colors motion-reduce:transition-none focus:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-[hsl(var(--background))] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[hsl(var(--ring))] disabled:cursor-not-allowed disabled:opacity-50 text-xs border-[var(--desk-line-color)] bg-[var(--desk-surface)] text-muted-foreground hover:bg-[var(--desk-surface-hover)] hover:text-foreground text-left " style="display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; padding: 4px 12px 4px 12px; border-width: 1px; border-style: solid; border-radius: 999px; justify-content: flex-start; width: 100%;">Send back…</button></div>"`;

exports[`kit snapshots > GradeBadge, every grade 1`] = `"<div><span data-grade="A" class="desk-pill text-[11px] font-semibold leading-5 bg-[hsl(var(--desk-emerald))] border-[hsl(var(--desk-emerald))] text-[hsl(var(--desk-on-fill))]" style="display: inline-flex; align-items: center; gap: 4px; white-space: nowrap; padding: 0px 6px 0px 6px; border-width: 1px; border-style: solid; border-radius: 999px; line-height: 20px;">A</span><span data-grade="B" class="desk-pill text-[11px] font-semibold leading-5 bg-[hsl(var(--desk-teal))] border-[hsl(var(--desk-teal))] text-[hsl(var(--desk-on-fill))]" style="display: inline-flex; align-items: center; gap: 4px; white-space: nowrap; padding: 0px 6px 0px 6px; border-width: 1px; border-style: solid; border-radius: 999px; line-height: 20px;">B</span><span data-grade="C" class="desk-pill text-[11px] font-semibold leading-5 bg-[hsl(var(--desk-amber))] border-[hsl(var(--desk-amber))] text-[hsl(var(--desk-on-amber))]" style="display: inline-flex; align-items: center; gap: 4px; white-space: nowrap; padding: 0px 6px 0px 6px; border-width: 1px; border-style: solid; border-radius: 999px; line-height: 20px;">C</span><span data-grade="D" class="desk-pill text-[11px] font-semibold leading-5 bg-[hsl(var(--desk-red))] border-[hsl(var(--desk-red))] text-[hsl(var(--desk-on-fill))]" style="display: inline-flex; align-items: center; gap: 4px; white-space: nowrap; padding: 0px 6px 0px 6px; border-width: 1px; border-style: solid; border-radius: 999px; line-height: 20px;">D</span><span data-grade="N" class="desk-pill text-[11px] font-semibold leading-5 bg-[hsl(var(--desk-slate)/0.25)] border-[hsl(var(--desk-slate)/0.5)] text-foreground" style="display: inline-flex; align-items: center; gap: 4px; white-space: nowrap; padding: 0px 6px 0px 6px; border-width: 1px; border-style: solid; border-radius: 999px; line-height: 20px;">New</span><span data-grade="X" class="desk-pill text-[11px] font-semibold leading-5 bg-[hsl(var(--desk-blocked))] border-[var(--desk-blocked-line)] text-[hsl(var(--desk-on-fill))]" style="display: inline-flex; align-items: center; gap: 4px; white-space: nowrap; padding: 0px 6px 0px 6px; border-width: 1px; border-style: solid; border-radius: 999px; line-height: 20px;">Blocked</span><span data-grade="none" class="desk-pill text-[11px] font-semibold leading-5 bg-[hsl(var(--desk-slate)/0.2)] border-[hsl(var(--desk-slate)/0.4)] text-muted-foreground" style="display: inline-flex; align-items: center; gap: 4px; white-space: nowrap; padding: 0px 6px 0px 6px; border-width: 1px; border-style: solid; border-radius: 999px; line-height: 20px;">Not graded</span></div>"`;

exports[`kit snapshots > Segmented, Tile, Fold, states 1`] = `"<div><div style="display: flex; align-items: center; gap: 6px; min-width: 0; max-width: 100%;"><div role="group" aria-label="Period" data-fade="none" class="desk-scroll-row" style="position: relative; display: flex; flex-wrap: nowrap; align-items: center; gap: 6px; min-width: 0; max-width: 100%; overflow-x: auto; overflow-y: hidden;"><button type="button" data-seg-index="0" aria-pressed="true" class="desk-pill text-xs font-medium transition-colors motion-reduce:transition-none focus:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-[hsl(var(--background))] border-[hsl(var(--primary)/0.6)] bg-[hsl(var(--primary)/0.18)] text-foreground" style="display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; padding: 6px 12px 6px 12px; border-width: 1px; border-style: solid; border-radius: 999px; flex-shrink: 0;">Today</button><button type="button" data-seg-index="1" aria-pressed="false" class="desk-pill text-xs font-medium transition-colors motion-reduce:transition-none focus:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-[hsl(var(--background))] border-[var(--desk-line-color)] bg-[var(--desk-surface)] text-muted-foreground hover:bg-[var(--desk-surface-hover)] hover:text-foreground" style="display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; padding: 6px 12px 6px 12px; border-width: 1px; border-style: solid; border-radius: 999px; flex-shrink: 0;">7 days</button></div></div><div class="desk-tile-row" style="display: grid; gap: var(--desk-space-3, 12px); grid-template-columns: repeat(auto-fit, minmax(min(150px, calc((100% - 12px) / 2)), 1fr)); min-width: 0;"><div class="desk-tile" style="display: flex; flex-direction: column; gap: 8px; min-width: 0; padding: clamp((12px * 20px) * , * , * calc(2.4vw - 4.6px)); container-type: inline-size;"><div class="desk-label">Fund today</div><div style="display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px; min-width: 0;"><div class="desk-figure tabular-nums font-semibold text-foreground text-[36px] leading-none " style="font-size: min(clamp(22px, 5vw, 36px), 20.8333333333333cqi); line-height: 1.32; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%;" data-figure-size="36" title="UGX 1,200,000" aria-label="UGX 1,200,000">UGX 1.2M</div></div><div class="desk-label truncate" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="3 on the board, not held">3 on the board, not held</div></div><div class="desk-tile" style="display: flex; flex-direction: column; gap: 8px; min-width: 0; padding: clamp((12px * 20px) * , * , * calc(2.4vw - 4.6px)); container-type: inline-size;"><div class="desk-label">Untouched 48 h</div><div style="display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px; min-width: 0;"><div class="desk-figure tabular-nums font-semibold text-foreground text-[44px] leading-none text-[hsl(var(--desk-warn))]" style="font-size: min(clamp(28px, 4vw, 44px), 166.6666666666667cqi); line-height: 1.32; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%;" data-figure-size="44">2</div></div></div></div><section class="desk-panel desk-fold min-w-0" data-open="false" style="display: flex; flex-direction: column; gap: var(--desk-card-gap, 14px); min-width: 0; padding: var(--desk-space-4, 16px) var(--desk-card-pad, 20px);"><h2 class="text-base font-semibold text-foreground" style="margin: 0px;"><button type="button" aria-expanded="false" class="w-full rounded-lg text-left transition-colors motion-reduce:transition-none focus:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-[hsl(var(--background))]" style="display: flex; flex-wrap: wrap; align-items: center; gap: 8px; width: 100%;"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right h-4 w-4 shrink-0 text-muted-foreground transition-transform motion-reduce:transition-none" style="flex-shrink: 0;" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg><span>Rules for this desk</span><span data-tone="idle" class="desk-pill text-xs  bg-[var(--desk-surface)] border-[var(--desk-line-color)] text-muted-foreground tabular-nums" style="display: inline-flex; align-items: center; gap: 4px; white-space: nowrap; padding: 2px 10px 2px 10px; border-width: 1px; border-style: solid; border-radius: 999px;">4</span><span class="h-2 w-2 rounded-full bg-[hsl(var(--desk-warn-dot)/0.8)]" style="display: inline-block; width: 8px; height: 8px; border-radius: 999px; flex-shrink: 0;" role="img" aria-label="Changed this week" title="Changed this week"></span></button></h2></section><p class="text-sm leading-snug text-muted-foreground" style="margin: 0px; padding-top: 4px; padding-bottom: 4px;">Nothing is waiting at this desk.</p><p role="alert" class="text-sm text-[hsl(var(--desk-bad))]" style="margin: 0px;">The board could not load: offline</p><div role="status" aria-label="Loading" style="display: flex; flex-direction: column; gap: 8px; min-width: 0;"><div style="height: 20px; width: 100%;"><div class="desk-shimmer rounded-lg bg-[var(--desk-surface)] h-full w-full" aria-hidden="true"></div></div><div style="height: 20px; width: 75%;"><div class="desk-shimmer rounded-lg bg-[var(--desk-surface)] h-full w-full" aria-hidden="true"></div></div></div></div>"`;
