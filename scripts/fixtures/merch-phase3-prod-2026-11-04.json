 "triggers": [
  "CREATE TRIGGER trg_bike_plan_complete_at_zero BEFORE UPDATE ON public.merchandise_recovery_plans FOR EACH ROW EXECUTE FUNCTION trg_bike_plan_complete_at_zero()",
  "CREATE TRIGGER trg_bike_plan_completed_notify AFTER UPDATE OF status ON public.merchandise_recovery_plans FOR EACH ROW EXECUTE FUNCTION trg_bike_plan_completed_notify()",
  "CREATE TRIGGER trg_bike_plan_unhold_starts_month1 BEFORE UPDATE OF recovery_hold ON public.merchandise_recovery_plans FOR EACH ROW EXECUTE FUNCTION trg_bike_plan_unhold_starts_month1()",
  "CREATE TRIGGER trg_flag_bike_lease_plan BEFORE INSERT ON public.merchandise_recovery_plans FOR EACH ROW EXECUTE FUNCTION trg_flag_bike_lease_plan()",
  "CREATE TRIGGER trg_merch_receivable_plan_delete BEFORE DELETE ON public.merchandise_recovery_plans FOR EACH ROW EXECUTE FUNCTION trg_merch_receivable_plan_event()",
  "CREATE TRIGGER trg_merch_receivable_plan_status AFTER UPDATE OF status ON public.merchandise_recovery_plans FOR EACH ROW WHEN (((old.status IS DISTINCT FROM new.status) AND (new.status = 'cancelled'::text))) EXECUTE FUNCTION trg_merch_receivable_plan_event()",
  "CREATE TRIGGER trg_zz_bike_plan_zero_daily_rate BEFORE INSERT OR UPDATE ON public.merchandise_recovery_plans FOR EACH ROW EXECUTE FUNCTION trg_bike_plan_zero_daily_rate()",
  "CREATE TRIGGER update_merch_recovery_plans_updated_at BEFORE UPDATE ON public.merchandise_recovery_plans FOR EACH ROW EXECUTE FUNCTION update_updated_at_column()",
  "CREATE TRIGGER trg_create_merchandise_recovery_plan AFTER INSERT ON public.merchandise_sales FOR EACH ROW EXECUTE FUNCTION create_merchandise_recovery_plan()",
  "CREATE TRIGGER trg_merch_hold_for_handover BEFORE UPDATE OF order_status ON public.merchandise_sales FOR EACH ROW EXECUTE FUNCTION trg_merch_hold_for_handover()",
  "CREATE TRIGGER trg_merch_receivable_sale_delete BEFORE DELETE ON public.merchandise_sales FOR EACH ROW EXECUTE FUNCTION trg_merch_receivable_sale_event()",
  "CREATE TRIGGER trg_merch_receivable_sale_status AFTER UPDATE OF order_status ON public.merchandise_sales FOR EACH ROW WHEN (((old.order_status IS DISTINCT FROM new.order_status) AND (new.order_status = ANY (ARRAY['rejected'::text, 'failed'::text, 'cancelled'::text])))) EXECUTE FUNCTION trg_merch_receivable_sale_event()",
  "CREATE TRIGGER trg_merch_stamp_fulfilment_type BEFORE INSERT ON public.merchandise_sales FOR EACH ROW EXECUTE FUNCTION trg_merch_stamp_fulfilment_type()",
  "CREATE TRIGGER trg_merchandise_sale_cascade_recovery BEFORE DELETE ON public.merchandise_sales FOR EACH ROW EXECUTE FUNCTION merchandise_sale_cascade_recovery()",
  "CREATE TRIGGER trg_merchandise_sync_completion BEFORE INSERT OR UPDATE OF order_status, amount_outstanding, amount_paid ON public.merchandise_sales FOR EACH ROW EXECUTE FUNCTION merchandise_sync_completion()",
  "CREATE TRIGGER trg_sync_bike_lease_from_sale AFTER INSERT OR UPDATE ON public.merchandise_sales FOR EACH ROW EXECUTE FUNCTION sync_bike_lease_from_sale()",
  "CREATE TRIGGER update_merchandise_sales_updated_at BEFORE UPDATE ON public.merchandise_sales FOR EACH ROW EXECUTE FUNCTION update_updated_at_column()"
